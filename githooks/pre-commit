#!/bin/sh
DB="assets/data/config.db"
DUMP="assets/data/config_db_dump.sql"

if [ ! -f "$DB" ]; then
    echo "[pre-commit] $DB not found, skipping dump"
    exit 0
fi

echo "[pre-commit] Dumping database to $DUMP ..."
python - "$DB" "$DUMP" <<'PYEOF'
import sqlite3
import sys

source = sys.argv[1]
target = sys.argv[2]
con = sqlite3.connect(source)
with open(target, "w", encoding="utf-8") as output:
    for line in con.iterdump():
        output.write(line + "\n")
PYEOF

git add "$DUMP"

if git ls-files --error-unmatch "$DB" >/dev/null 2>&1; then
    echo "[pre-commit] Unstaging binary $DB ..."
    git rm --cached "$DB" 2>/dev/null
fi

echo "[pre-commit] Checking architecture constraints ..."
python tools/check_architecture.py || exit 1
echo "[pre-commit] Done — $DUMP staged"